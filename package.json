{
  "name": "react-paginate-ts",
  "version": "1.0.0",
  "description": "Lightweight, accessible and fully typed pagination component and headless hook for React.",
  "keywords": [
    "react",
    "pagination",
    "paginate",
    "pager",
    "typescript",
    "hook",
    "headless",
    "component"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/react-paginate-ts.git"
  },
  "homepage": "https://github.com/FeruzDev/react-paginate-ts#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/react-paginate-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
